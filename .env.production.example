NODE_ENV=production

# Nom de domaine ou sous-domaine
DOMAIN=shopcontrol.duckdns.org

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=shopcontrol
POSTGRES_PASSWORD=change_this_to_a_secure_postgres_password_123!
POSTGRES_CONTROL_DB=shopcontrol_control

DATABASE_URL=postgresql://shopcontrol:change_this_to_a_secure_postgres_password_123!@postgres:5432/shopcontrol_control?schema=public
POSTGRES_ADMIN_URL=postgresql://shopcontrol:change_this_to_a_secure_postgres_password_123!@postgres:5432/postgres

SHOP_DB_PREFIX=shopcontrol_shop_
SHOP_DB_MAX_POOLED_CLIENTS=40
SHOP_DB_CONNECTION_LIMIT=3

REDIS_URL=redis://redis:6379

API_PORT=4000
API_URL=https://shopcontrol.duckdns.org
APP_URL=https://shopcontrol.duckdns.org
CORS_ORIGINS=https://shopcontrol.duckdns.org
NEXT_PUBLIC_API_URL=/api/v1

JWT_ACCESS_SECRET=dev_access_secret_replace_in_production_minimum_64_chars_0123456789abcdef
JWT_REFRESH_SECRET=dev_refresh_secret_replace_in_production_minimum_64_chars_fedcba9876543210
JWT_ACCESS_TTL_SECONDS=86400
SESSION_TTL_OWNER_HOURS=720
SESSION_TTL_AGENT_HOURS=720
SESSION_TTL_SUPER_ADMIN_HOURS=720
COOKIE_SECURE=true

TOTP_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

BOOTSTRAP_SUPER_ADMIN_EMAIL=chakirunisphereai@gmail.com
BOOTSTRAP_SUPER_ADMIN_PASSWORD=ChangeMe!Admin2026
BOOTSTRAP_SUPER_ADMIN_NAME=Administrateur ShopControl

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@shopcontrol.local

# Sauvegarde quotidienne vers Telegram (canal prive)
BACKUP_ENABLED=false
BACKUP_TELEGRAM_BOT_TOKEN=
BACKUP_TELEGRAM_CHAT_ID=
PG_DUMP_PATH=pg_dump
