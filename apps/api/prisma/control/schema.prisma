generator client {
  provider = "prisma-client-js"
  output   = "../../src/generated/prisma-control"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  OWNER
  AGENT
  CLIENT
}

enum TenantStatus {
  ACTIVE
  PAST_DUE
  SUSPENDED
  TERMINATED
}

enum ShopDbStatus {
  PROVISIONING
  READY
  MIGRATION_FAILED
}

enum TaxMode {
  NONE
  TTC
  HT
}

enum NotificationType {
  ORDER
  MESSAGING
  STOCK
  CASH_FINANCE
  TRANSFER
  SECURITY
  PLATFORM
}

enum NotificationPriority {
  INFO
  WARNING
  URGENT
}

model Merchant {
  id                String       @id @default(uuid()) @db.Uuid
  name              String       @db.VarChar(120)
  legalName         String?      @map("legal_name") @db.VarChar(160)
  phone             String       @db.VarChar(30)
  email             String       @db.VarChar(160)
  status            TenantStatus @default(ACTIVE)
  statusReason      String?      @map("status_reason") @db.VarChar(500)
  gracePeriodEndsAt DateTime?    @map("grace_period_ends_at") @db.Timestamptz(6)
  currency          String       @default("XOF") @db.VarChar(5)
  defaultTimezone   String       @default("Africa/Bamako") @map("default_timezone") @db.VarChar(60)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  shops               Shop[]
  users               User[]
  supportAccessGrants SupportAccessGrant[]
  notifications       Notification[]
  auditLogs           AuditLog[]
  companyExpenses     CompanyExpense[]
  stockTransfers      StockTransfer[]
  conversations       Conversation[]
  subscription        MerchantSubscription?
  platformPayments    PlatformPayment[]
  supportTickets      SupportTicket[]

  @@index([status])
  @@index([createdAt])
  @@map("merchants")
}

model Shop {
  id                 String       @id @default(uuid()) @db.Uuid
  merchantId         String       @map("merchant_id") @db.Uuid
  name               String       @db.VarChar(120)
  slug               String       @unique @db.VarChar(64)
  status             TenantStatus @default(ACTIVE)
  statusReason       String?      @map("status_reason") @db.VarChar(500)
  dbName             String       @unique @map("db_name") @db.VarChar(63)
  dbStatus           ShopDbStatus @default(PROVISIONING) @map("db_status")
  dbSchemaVersion    String?      @map("db_schema_version") @db.VarChar(64)
  logoUrl            String?      @map("logo_url") @db.VarChar(500)
  phone              String?      @db.VarChar(30)
  email              String?      @db.VarChar(160)
  address            String?      @db.VarChar(255)
  openingHours       Json         @map("opening_hours")
  currency           String       @default("XOF") @db.VarChar(5)
  timezone           String       @default("Africa/Bamako") @db.VarChar(60)
  dailyReportTime    String       @default("22:00") @map("daily_report_time") @db.VarChar(5)
  taxMode            TaxMode      @default(NONE) @map("tax_mode")
  defaultTaxRateBps  Int          @default(0) @map("default_tax_rate_bps")
  paymentMethods     Json         @map("payment_methods")
  deliveryConfig     Json         @default("{}") @map("delivery_config")
  receiptSettings    Json         @default("{}") @map("receipt_settings")
  requireOperatorPin Boolean      @default(false) @map("require_operator_pin")
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  merchant       Merchant           @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  slugRedirects  ShopSlugRedirect[]
  userAccesses   UserShopAccess[]
  notifications  Notification[]
  auditLogs      AuditLog[]
  outgoingTransfers StockTransfer[] @relation("TransferSourceShop")
  incomingTransfers StockTransfer[] @relation("TransferDestShop")
  conversations  Conversation[]

  @@index([merchantId])
  @@index([status])
  @@index([merchantId, status])
  @@map("shops")
}

model ShopSlugRedirect {
  id        String   @id @default(uuid()) @db.Uuid
  oldSlug   String   @unique @map("old_slug") @db.VarChar(64)
  shopId    String   @map("shop_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@map("shop_slug_redirects")
}

model User {
  id                  String    @id @default(uuid()) @db.Uuid
  merchantId          String?   @map("merchant_id") @db.Uuid
  role                UserRole
  email               String    @unique @db.VarChar(160)
  phone               String?   @db.VarChar(30)
  fullName            String    @map("full_name") @db.VarChar(120)
  passwordHash        String    @map("password_hash")
  isActive            Boolean   @default(true) @map("is_active")
  totpSecretEncrypted String?   @map("totp_secret_encrypted")
  totpEnabled         Boolean   @default(false) @map("totp_enabled")
  failedLoginCount    Int       @default(0) @map("failed_login_count")
  lockedUntil         DateTime? @map("locked_until") @db.Timestamptz(6)
  lastLoginAt         DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  merchant            Merchant?            @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  shopAccesses        UserShopAccess[]
  sessions            UserSession[]
  notifications       Notification[]
  supportGrantsIssued SupportAccessGrant[] @relation("SuperAdminGrants")
  auditLogs           AuditLog[]

  @@index([merchantId])
  @@index([role])
  @@index([merchantId, role])
  @@map("users")
}

model UserShopAccess {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String   @map("user_id") @db.Uuid
  shopId              String   @map("shop_id") @db.Uuid
  permissions         Json
  maxDiscountPercent  Int      @default(0) @map("max_discount_percent")
  maxExpenseAmountXof Int      @default(0) @map("max_expense_amount_xof")
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([userId, shopId])
  @@index([shopId])
  @@map("user_shop_access")
}

model UserSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash") @db.VarChar(128)
  deviceName       String?   @map("device_name") @db.VarChar(120)
  userAgent        String?   @map("user_agent") @db.VarChar(500)
  ipAddress        String?   @map("ip_address") @db.VarChar(64)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  lastActiveAt     DateTime  @default(now()) @map("last_active_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedByUserId  String?   @map("revoked_by_user_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("user_sessions")
}

model SupportAccessGrant {
  id              String    @id @default(uuid()) @db.Uuid
  superAdminId    String    @map("super_admin_id") @db.Uuid
  merchantId      String    @map("merchant_id") @db.Uuid
  reason          String    @db.VarChar(500)
  readOnly        Boolean   @default(true) @map("read_only")
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedByUserId String?   @map("revoked_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  superAdmin User     @relation("SuperAdminGrants", fields: [superAdminId], references: [id], onDelete: Restrict)
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Restrict)

  @@index([superAdminId, merchantId, expiresAt])
  @@index([merchantId, createdAt])
  @@map("support_access_grants")
}

model Notification {
  id              String               @id @default(uuid()) @db.Uuid
  merchantId      String?              @map("merchant_id") @db.Uuid
  shopId          String?              @map("shop_id") @db.Uuid
  recipientUserId String               @map("recipient_user_id") @db.Uuid
  type            NotificationType
  priority        NotificationPriority @default(INFO)
  title           String               @db.VarChar(180)
  message         String               @db.VarChar(1000)
  targetPath      String?              @map("target_path") @db.VarChar(255)
  isRead          Boolean              @default(false) @map("is_read")
  readAt          DateTime?            @map("read_at") @db.Timestamptz(6)
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  merchant  Merchant? @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  shop      Shop?     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  recipient User      @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@index([recipientUserId, isRead, createdAt])
  @@index([merchantId, createdAt])
  @@map("notifications")
}

model AuditLog {
  id                   String    @id @default(uuid()) @db.Uuid
  sequenceNumber       BigInt    @unique @default(autoincrement()) @map("sequence_number")
  merchantId           String?   @map("merchant_id") @db.Uuid
  shopId               String?   @map("shop_id") @db.Uuid
  actorUserId          String?   @map("actor_user_id") @db.Uuid
  actorRole            UserRole? @map("actor_role")
  declaredOperatorId   String?   @map("declared_operator_id") @db.Uuid
  declaredOperatorName String?   @map("declared_operator_name") @db.VarChar(80)
  action               String    @db.VarChar(80)
  entityType           String    @map("entity_type") @db.VarChar(80)
  entityId             String?   @map("entity_id") @db.VarChar(120)
  beforeData           Json?     @map("before_data")
  afterData            Json?     @map("after_data")
  reason               String?   @db.VarChar(500)
  ipAddress            String?   @map("ip_address") @db.VarChar(64)
  userAgent            String?   @map("user_agent") @db.VarChar(500)
  correlationId        String?   @map("correlation_id") @db.VarChar(120)
  prevHash             String    @map("prev_hash") @db.VarChar(64)
  entryHash            String    @map("entry_hash") @db.VarChar(64)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  merchant Merchant? @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  shop     Shop?     @relation(fields: [shopId], references: [id], onDelete: Restrict)
  actor    User?     @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([merchantId, createdAt])
  @@index([shopId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model CompanyExpense {
  id                String    @id @default(uuid()) @db.Uuid
  merchantId        String    @map("merchant_id") @db.Uuid
  categoryName      String    @map("category_name") @db.VarChar(80)
  amountXof         Int       @map("amount_xof")
  expenseDate       DateTime  @default(now()) @map("expense_date") @db.Timestamptz(6)
  paymentMethodCode String    @default("BANK") @map("payment_method_code") @db.VarChar(32)
  beneficiary       String?   @db.VarChar(120)
  note              String?   @db.VarChar(500)
  status            String    @default("ACTIVE") @db.VarChar(20)
  cancelReason      String?   @map("cancel_reason") @db.VarChar(500)
  cancelledAt       DateTime? @map("cancelled_at") @db.Timestamptz(6)
  actorUserId       String    @map("actor_user_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Restrict)

  @@index([merchantId, expenseDate])
  @@index([merchantId, status])
  @@map("company_expenses")
}

// ============================================================================
// LOT 4 — TRANSFERTS INTER-BOUTIQUES (COORDINATION MULTI-BDD)
// ============================================================================

model StockTransfer {
  id                      String    @id @default(uuid()) @db.Uuid
  merchantId              String    @map("merchant_id") @db.Uuid
  transferNumber          String    @unique @map("transfer_number") @db.VarChar(40)
  sourceShopId            String    @map("source_shop_id") @db.Uuid
  destShopId              String    @map("dest_shop_id") @db.Uuid
  status                  String    @default("PENDING_APPROVAL") @db.VarChar(32)
  requestedByUserId       String    @map("requested_by_user_id") @db.Uuid
  requestedByOperatorName String?   @map("requested_by_operator_name") @db.VarChar(80)
  approvedByUserId        String?   @map("approved_by_user_id") @db.Uuid
  approvedAt              DateTime? @map("approved_at") @db.Timestamptz(6)
  rejectedReason          String?   @map("rejected_reason") @db.VarChar(500)
  dispatchedByUserId      String?   @map("dispatched_by_user_id") @db.Uuid
  dispatchedByOperatorName String?  @map("dispatched_by_operator_name") @db.VarChar(80)
  dispatchedAt            DateTime? @map("dispatched_at") @db.Timestamptz(6)
  receivedByUserId        String?   @map("received_by_user_id") @db.Uuid
  receivedByOperatorName  String?   @map("received_by_operator_name") @db.VarChar(80)
  receivedAt              DateTime? @map("received_at") @db.Timestamptz(6)
  hasDiscrepancy          Boolean   @default(false) @map("has_discrepancy")
  notes                   String?   @db.VarChar(500)
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  merchant   Merchant            @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  sourceShop Shop                @relation("TransferSourceShop", fields: [sourceShopId], references: [id], onDelete: Restrict)
  destShop   Shop                @relation("TransferDestShop", fields: [destShopId], references: [id], onDelete: Restrict)
  items      StockTransferItem[]

  @@index([merchantId, status, createdAt])
  @@index([sourceShopId, status])
  @@index([destShopId, status])
  @@map("stock_transfers")
}

model StockTransferItem {
  id                String  @id @default(uuid()) @db.Uuid
  transferId        String  @map("transfer_id") @db.Uuid
  sourceProductId   String  @map("source_product_id") @db.Uuid
  destProductId     String? @map("dest_product_id") @db.Uuid
  productSku        String  @map("product_sku") @db.VarChar(64)
  productName       String  @map("product_name") @db.VarChar(160)
  salePriceXof      Int     @default(0) @map("sale_price_xof")
  unitCostXof       Int?    @map("unit_cost_xof")
  requestedQty      Int     @map("requested_qty")
  dispatchedQty     Int     @default(0) @map("dispatched_qty")
  receivedQty       Int     @default(0) @map("received_qty")
  discrepancyReason String? @map("discrepancy_reason") @db.VarChar(300)

  transfer StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  @@index([transferId])
  @@map("stock_transfer_items")
}

// ============================================================================
// LOT 6 — MESSAGERIE UNIFIÉE (PROPRIÉTAIRE, AGENTS, CLIENTS, SUPPORT)
// ============================================================================

model Conversation {
  id                  String   @id @default(uuid()) @db.Uuid
  merchantId          String   @map("merchant_id") @db.Uuid
  shopId              String?  @map("shop_id") @db.Uuid
  type                String   @db.VarChar(32)
  status              String   @default("OPEN") @db.VarChar(16)
  subject             String   @db.VarChar(180)
  orderId             String?  @map("order_id") @db.Uuid
  orderNumber         String?  @map("order_number") @db.VarChar(40)
  clientName          String?  @map("client_name") @db.VarChar(120)
  clientPhone         String?  @map("client_phone") @db.VarChar(30)
  clientSecretToken   String?  @unique @map("client_secret_token") @db.VarChar(96)
  assignedAgentUserId String?  @map("assigned_agent_user_id") @db.Uuid
  lastMessageAt       DateTime @default(now()) @map("last_message_at") @db.Timestamptz(6)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  merchant Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  shop     Shop?     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([merchantId, lastMessageAt])
  @@index([shopId, lastMessageAt])
  @@index([type, lastMessageAt])
  @@map("conversations")
}

model Message {
  id                   String   @id @default(uuid()) @db.Uuid
  conversationId       String   @map("conversation_id") @db.Uuid
  senderRole           String   @map("sender_role") @db.VarChar(24)
  senderUserId         String?  @map("sender_user_id") @db.Uuid
  senderName           String   @map("sender_name") @db.VarChar(120)
  declaredOperatorName String?  @map("declared_operator_name") @db.VarChar(80)
  body                 String   @db.VarChar(2000)
  attachmentUrl        String?  @map("attachment_url") @db.VarChar(500)
  isRead               Boolean  @default(false) @map("is_read")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

// ============================================================================
// LOT 7 — ADMINISTRATION PLATEFORME (ABONNEMENTS, MODULES, PAIEMENTS, SUPPORT, ANNONCES)
// ============================================================================

model MerchantSubscription {
  id                   String   @id @default(uuid()) @db.Uuid
  merchantId           String   @unique @map("merchant_id") @db.Uuid
  planCode             String   @default("PRO") @map("plan_code") @db.VarChar(32)
  monthlyPriceXof      Int      @default(25000) @map("monthly_price_xof")
  maxShops             Int      @default(5) @map("max_shops")
  maxAgentsPerShop     Int      @default(10) @map("max_agents_per_shop")
  enabledModules       Json     @default("[\"POS\",\"INVENTORY\",\"PURCHASES\",\"MULTI_SHOP\",\"ECOMMERCE_QR\",\"MESSAGING\",\"REPORTS\"]") @map("enabled_modules")
  currentPeriodStart   DateTime @default(now()) @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd     DateTime @map("current_period_end") @db.Timestamptz(6)
  autoSuspendGraceDays Int      @default(7) @map("auto_suspend_grace_days")
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@map("merchant_subscriptions")
}

model PlatformPayment {
  id                String   @id @default(uuid()) @db.Uuid
  merchantId        String   @map("merchant_id") @db.Uuid
  amountXof         Int      @map("amount_xof")
  paymentMethodCode String   @map("payment_method_code") @db.VarChar(32)
  reference         String?  @db.VarChar(120)
  periodLabel       String   @map("period_label") @db.VarChar(80)
  notes             String?  @db.VarChar(300)
  recordedByUserId  String   @map("recorded_by_user_id") @db.Uuid
  paidAt            DateTime @default(now()) @map("paid_at") @db.Timestamptz(6)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Restrict)

  @@index([merchantId, paidAt])
  @@map("platform_payments")
}

model SupportTicket {
  id              String   @id @default(uuid()) @db.Uuid
  ticketNumber    String   @unique @map("ticket_number") @db.VarChar(32)
  merchantId      String   @map("merchant_id") @db.Uuid
  createdByUserId String   @map("created_by_user_id") @db.Uuid
  subject         String   @db.VarChar(180)
  status          String   @default("OPEN") @db.VarChar(24)
  priority        String   @default("INFO") @db.VarChar(16)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  merchant Merchant               @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  messages SupportTicketMessage[]

  @@index([merchantId, status])
  @@index([status, updatedAt])
  @@map("support_tickets")
}

model SupportTicketMessage {
  id           String   @id @default(uuid()) @db.Uuid
  ticketId     String   @map("ticket_id") @db.Uuid
  senderUserId String   @map("sender_user_id") @db.Uuid
  senderRole   String   @map("sender_role") @db.VarChar(24)
  senderName   String   @map("sender_name") @db.VarChar(120)
  body         String   @db.VarChar(2000)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@map("support_ticket_messages")
}

model PlatformAnnouncement {
  id                String    @id @default(uuid()) @db.Uuid
  title             String    @db.VarChar(160)
  body              String    @db.VarChar(1500)
  priority          String    @default("INFO") @db.VarChar(16)
  targetRole        String    @default("ALL") @map("target_role") @db.VarChar(16)
  isActive          Boolean   @default(true) @map("is_active")
  publishedByUserId String    @map("published_by_user_id") @db.Uuid
  expiresAt         DateTime? @map("expires_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([isActive, createdAt])
  @@map("platform_announcements")
}
