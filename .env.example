# ==============================================================================
# ShopControl — Variables d'environnement (copier vers .env pour le dev local)
# Ne jamais committer .env !
# ==============================================================================

NODE_ENV=development

# Base de données PostgreSQL (Control Plane + serveur de provisionnement des bases boutiques)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=shopcontrol
POSTGRES_PASSWORD=shopcontrol_dev_change_me
POSTGRES_CONTROL_DB=shopcontrol_control

# URL Prisma pour la base Control Plane
DATABASE_URL=postgresql://shopcontrol:shopcontrol_dev_change_me@localhost:5433/shopcontrol_control?schema=public

# URL d'administration PostgreSQL (utilisée pour CREATE DATABASE lors de la création d'une boutique)
POSTGRES_ADMIN_URL=postgresql://shopcontrol:shopcontrol_dev_change_me@localhost:5433/postgres

# Préfixe des bases dédiées par boutique (ex: shopcontrol_shop_<shortId>)
SHOP_DB_PREFIX=shopcontrol_shop_
SHOP_DB_MAX_POOLED_CLIENTS=40
SHOP_DB_CONNECTION_LIMIT=3

# Redis (rate limiting, lockout, sessions, pub/sub)
REDIS_URL=redis://localhost:6379

# API & Frontend URLs
API_PORT=4000
API_URL=http://localhost:4000
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Authentification & Sécurité (REMPLACER EN PRODUCTION par des clés aléatoires >= 64 caractères)
JWT_ACCESS_SECRET=dev_access_secret_replace_in_production_minimum_64_chars_0123456789abcdef
JWT_REFRESH_SECRET=dev_refresh_secret_replace_in_production_minimum_64_chars_fedcba9876543210
JWT_ACCESS_TTL_SECONDS=900
SESSION_TTL_OWNER_HOURS=24
SESSION_TTL_AGENT_HOURS=4
SESSION_TTL_SUPER_ADMIN_HOURS=8
COOKIE_SECURE=false

# Clé de chiffrement AES-256-GCM (64 caractères hex = 32 octets) pour secrets TOTP 2FA
TOTP_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Bootstrap du Super Admin initial (utilisé uniquement par npm run db:seed)
BOOTSTRAP_SUPER_ADMIN_EMAIL=admin@shopcontrol.local
BOOTSTRAP_SUPER_ADMIN_PASSWORD=ChangeMe!Admin2026
BOOTSTRAP_SUPER_ADMIN_NAME=Administrateur ShopControl

# SMTP (Mailpit en local)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@shopcontrol.local
